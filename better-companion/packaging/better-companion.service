# Optional systemd user unit for the Better Niri automation daemon.
#
# niri-session imports the Wayland and NIRI_SOCKET environment into the user
# manager, so the unit is ordered after graphical-session.target instead of
# starting before niri. Enable it with:
#
#   systemctl --user enable --now better-companion.service
#
# Deliberately no sandboxing (PrivateNetwork, PrivateTmp, ProtectHome): the
# daemon needs the niri IPC socket and launches user commands from rules.
[Unit]
Description=better-companion (Better Niri automation daemon)
Documentation=file:///usr/share/doc/better-companion/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/better-companion
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
