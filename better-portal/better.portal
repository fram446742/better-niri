# xdg-desktop-portal implementation descriptor for better-portal.
#
# Install as:
#   $XDG_DATA_DIRS/xdg-desktop-portal/portals/better.portal
# or, for a single user:
#   $XDG_DATA_HOME/xdg-desktop-portal/portals/better.portal
#
# The implementation name used in portals.conf is the file stem: "better".
#
# PickColor is part of org.freedesktop.impl.portal.Screenshot version 2, so it
# is covered by the Screenshot entry below; there is no separate
# org.freedesktop.impl.portal.PickColor interface in the portal specification.
[portal]
DBusName=org.freedesktop.impl.portal.desktop.better
Interfaces=org.freedesktop.impl.portal.Screenshot;org.freedesktop.impl.portal.ScreenCast;
UseIn=niri
