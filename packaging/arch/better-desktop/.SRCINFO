pkgbase = better-desktop
	pkgdesc = Meta package for the Better Niri desktop: compositor, portal and companion apps
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/fram446742/better-niri
	install = better-desktop.install
	arch = any
	license = GPL-3.0-or-later
	depends = niri-better
	optdepends = xdg-desktop-portal: portal broker for niri.portal and better.portal
	optdepends = xdg-desktop-portal-gtk: fallback portal for file chooser and friends
	optdepends = pipewire: audio and screencasting server
	optdepends = wireplumber: PipeWire session manager and wpctl
	optdepends = libpulse: pactl backend for better-audio
	optdepends = playerctl: media module in better-sidepanels
	optdepends = swaybg: default wallpaper command for better-wallpaper
	optdepends = satty: interactive annotation for better-shot
	optdepends = wl-clipboard: clipboard support in better-shot
	optdepends = dbus: dbus-update-activation-environment used by niri-session
	optdepends = systemd: systemctl, loginctl and busctl integration
	source = README.md
	sha256sums = SKIP

pkgname = better-desktop
