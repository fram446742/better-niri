#compdef loom-audio
# zsh completion for loom-audio (generated by packaging/scripts/generate-completions.py)
_loom_audio() {
    local -a commands
    commands=(
        'sinks'
        'sources'
        'streams'
        'links'
        'volume'
        'mute'
        'rules'
        'default'
        'profile'
        'apply'
        'restore'
        'watch'
        'diagnose'
        'status'
    )
    if (( CURRENT == 2 )); then
        _describe 'command' commands
    else
        _files
    fi
}
_loom_audio "$@"
