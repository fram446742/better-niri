#compdef loom
# zsh completion for loom (generated by packaging/scripts/generate-completions.py)
_loom() {
    local -a commands
    commands=(
        'companion'
        'companion-daemon'
        'portal'
        'portal-picker'
        'monitor'
        'session'
        'shot'
        'wallpaper'
        'settings'
        'settingsctl'
        'audio'
        'sidepanels'
        'tui'
    )
    if (( CURRENT == 2 )); then
        _describe 'command' commands
    else
        _files
    fi
}
_loom "$@"
