#compdef companionctl
# zsh completion for companionctl (generated by packaging/scripts/generate-completions.py)
_companionctl() {
    local -a commands
    commands=(
        'list'
        'describe'
        'status'
        'call'
        'explain'
        'history'
        'config'
        'subscribe'
    )
    if (( CURRENT == 2 )); then
        _describe 'command' commands
    else
        _files
    fi
}
_companionctl "$@"
