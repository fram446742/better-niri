#compdef better-monitor
# zsh completion for better-monitor (generated by packaging/scripts/generate-completions.py)
_better_monitor() {
    local -a commands
    commands=(
        'list'
        'show'
        'save'
        'apply'
        'confirm'
        'cancel'
        'restore'
        'delete'
        'migrate'
        'position'
        'arrange'
        'rules'
        'watch'
    )
    if (( CURRENT == 2 )); then
        _describe 'command' commands
    else
        _files
    fi
}
_better_monitor "$@"
