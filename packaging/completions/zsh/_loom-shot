#compdef loom-shot
# zsh completion for loom-shot (generated by packaging/scripts/generate-completions.py)
_loom_shot() {
    local -a commands
    commands=(
        'ui'
        'screen'
        'window'
        'record'
        'annotate'
        'history'
        'pin'
        'ocr'
    )
    if (( CURRENT == 2 )); then
        _describe 'command' commands
    else
        _files
    fi
}
_loom_shot "$@"
