#compdef loom-session
# zsh completion for loom-session (generated by packaging/scripts/generate-completions.py)
_loom_session() {
    local -a commands
    commands=(
        'list'
        'show'
        'capture'
        'save'
        'restore'
        'explain'
        'deactivate'
        'rename'
        'delete'
        'history'
        'snapshot'
        'export'
        'import'
        'template'
    )
    if (( CURRENT == 2 )); then
        _describe 'command' commands
    else
        _files
    fi
}
_loom_session "$@"
