#compdef loom-monitor
# zsh completion for loom-monitor (generated by packaging/scripts/generate-completions.py)
_loom_monitor() {
    local -a commands
    commands=(
        'list'
        'show'
        'save'
        'apply'
        'confirm'
        'cancel'
        'restore'
        'delete'
        'migrate'
        'position'
        'arrange'
        'rules'
        'watch'
    )
    if (( CURRENT == 2 )); then
        _describe 'command' commands
    else
        _files
    fi
}
_loom_monitor "$@"
