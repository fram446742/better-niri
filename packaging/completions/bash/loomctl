# bash completion for loomctl (generated by packaging/scripts/generate-completions.py)
_loomctl() {
    local cur prev cmd
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    local commands="list describe status call explain history config subscribe"
    local options="--socket --id --dry-run --help --version"

    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "$options" -- "$cur"))
        return 0
    fi
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
        return 0
    fi
    cmd="${COMP_WORDS[1]}"
    case "$cmd" in
        config)
            COMPREPLY=($(compgen -W "show validate reload" -- "$cur"))
            ;;
        history)
            COMPREPLY=($(compgen -W "list clear" -- "$cur"))
            ;;
        explain)
            COMPREPLY=($(compgen -W "rules windows" -- "$cur"))
            ;;
    esac
}
complete -F _loomctl loomctl
