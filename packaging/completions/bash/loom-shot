    local options="--socket --path --id --no-pointer --pointer --copy --annotate --hdr --format --quality --metadata --dry-run --json --stop --duration --fps --codec --region --window --output --audio --stitch --stitch-path --no-history --ocr --ocr-sidecar --preview --op --annotations --clear-log --history --list-ops --help --version"

