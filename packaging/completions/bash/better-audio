# bash completion for better-audio (generated by packaging/scripts/generate-completions.py)
_better_audio() {
    local cur prev cmd
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    local commands="sinks sources streams links volume mute rules default profile apply restore watch diagnose status"
    local options="--config --backend --pactl --wpctl --pw-dump --pw-cli --focus-command --json --dry-run --interval-ms --help --version"

    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "$options" -- "$cur"))
        return 0
    fi
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
        return 0
    fi
    cmd="${COMP_WORDS[1]}"
    case "$cmd" in
        rules)
            COMPREPLY=($(compgen -W "add remove" -- "$cur"))
            ;;
        profile)
            COMPREPLY=($(compgen -W "list show apply restore" -- "$cur"))
            ;;
    esac
}
complete -F _better_audio better-audio
