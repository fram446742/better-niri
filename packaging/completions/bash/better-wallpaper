# bash completion for better-wallpaper (generated by packaging/scripts/generate-completions.py)
_better_wallpaper() {
    local cur prev cmd
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    local commands="scene apply watch status"
    local options="--socket --backend --dry-run --session --help --version"

    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "$options" -- "$cur"))
        return 0
    fi
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
        return 0
    fi
    cmd="${COMP_WORDS[1]}"
    case "$cmd" in
        scene)
            COMPREPLY=($(compgen -W "set use session list show export import delete" -- "$cur"))
            ;;
    esac
}
complete -F _better_wallpaper better-wallpaper
