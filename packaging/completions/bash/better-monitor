# bash completion for better-monitor (generated by packaging/scripts/generate-completions.py)
_better_monitor() {
    local cur prev cmd
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    local commands="list show save apply confirm cancel restore delete migrate position arrange rules watch"
    local options="--socket --state --rules-file --plan --json --dry-run --once --confirm-timeout --pending --profile --priority --match-name --make --model --serial --output --debounce-ms --poll-ms --cooldown-ms --help --version"

    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "$options" -- "$cur"))
        return 0
    fi
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
        return 0
    fi
    cmd="${COMP_WORDS[1]}"
    case "$cmd" in
        rules)
            COMPREPLY=($(compgen -W "list add remove explain apply" -- "$cur"))
            ;;
    esac
}
complete -F _better_monitor better-monitor
