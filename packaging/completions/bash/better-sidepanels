# bash completion for better-sidepanels (generated by packaging/scripts/generate-completions.py)
_better_sidepanels() {
    local cur prev cmd
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    local commands=""
    local options="--config --profile --layout --check --validate --init --help --version"

    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "$options" -- "$cur"))
        return 0
    fi
    COMPREPLY=($(compgen -f -- "$cur"))
}
complete -F _better_sidepanels better-sidepanels
