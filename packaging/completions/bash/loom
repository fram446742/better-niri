# bash completion for loom (generated by packaging/scripts/generate-completions.py)
_loom() {
    local cur prev cmd
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    local commands="companion companion-daemon portal portal-picker monitor session shot wallpaper settings settingsctl audio sidepanels tui"
    local options="--list --version --help"

    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "$options" -- "$cur"))
        return 0
    fi
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
        return 0
    fi
    cmd="${COMP_WORDS[1]}"
    COMPREPLY=($(compgen -f -- "$cur"))
}
complete -F _loom loom
