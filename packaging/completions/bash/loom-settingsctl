# bash completion for loom-settingsctl (generated by packaging/scripts/generate-completions.py)
_loom_settingsctl() {
    local cur prev cmd
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    local commands="get set unset add-bind remove-bind add-window-rule remove-window-rule add-layer-rule remove-layer-rule add-startup remove-startup list validate export import diff integrations displays sessions wallpaper audio sidepanels companion"
    local options="--config --dry-run --raw --help --version"

    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "$options" -- "$cur"))
        return 0
    fi
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
        return 0
    fi
    cmd="${COMP_WORDS[1]}"
    COMPREPLY=($(compgen -f -- "$cur"))
}
complete -F _loom_settingsctl loom-settingsctl
