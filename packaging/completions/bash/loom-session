# bash completion for loom-session (generated by packaging/scripts/generate-completions.py)
_loom_session() {
    local cur prev cmd
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    local commands="list show capture save restore explain deactivate rename delete history snapshot export import template"
    local options="--socket --dry-run --explain --wait-ms --poll-ms --retry --force --snapshot-before --launch --hook-pre --hook-activate --hook-post --hook-deactivate --template --set --monitor-profile --monitor-via --monitor-command --audio-profile --audio-config --audio-command --wallpaper-scene --wallpaper-command --companion-rule --companion-call --companion-mark --companion-command --profile-activate --profile-deactivate --file --merge --replace --keep --max-age-days --auto --name --interval-ms --count --help --version"

    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "$options" -- "$cur"))
        return 0
    fi
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
        return 0
    fi
    cmd="${COMP_WORDS[1]}"
    case "$cmd" in
        history)
            COMPREPLY=($(compgen -W "list show restore prune" -- "$cur"))
            ;;
        template)
            COMPREPLY=($(compgen -W "list show apply" -- "$cur"))
            ;;
    esac
}
complete -F _loom_session loom-session
