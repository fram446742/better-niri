 impl Niri for NiriClient {
+    fn supports_native_sticky(&self) -> NiriFuture<'_, bool> {
+        Box::pin(async move {
+            let payload = self.request(&json!("Capabilities")).await?;
+            Ok(payload
+                .get("Capabilities")
+                .and_then(|capabilities| capabilities.get("sticky"))
+                .and_then(|sticky| sticky.as_bool())
+                .unwrap_or(false))
+        })
+    }
+
+    fn toggle_sticky(&self, window_id: u64) -> NiriFuture<'_, ()> {
+        Box::pin(async move {
+            self.request(&json!({
+                "Action": {
+                    "ToggleWindowSticky": { "id": window_id }
+                }
+            }))
+            .await?;
+            Ok(())
+        })
+    }
+
+    fn sticky_windows(&self) -> NiriFuture<'_, Vec<u64>> {
+        Box::pin(async move {
+            let payload = self.request(&json!("Windows")).await?;
+            let items = payload
+                .get("Windows")
+                .and_then(|windows| windows.as_array())
+                .cloned()
+                .unwrap_or_default();
+            let mut ids: Vec<u64> = items
+                .iter()
+                .filter(|item| item.get("is_sticky").and_then(|v| v.as_bool()) == Some(true))
+                .filter_map(|item| item.get("id").and_then(|v| v.as_u64()))
+                .collect();
+            ids.sort_unstable();
+            Ok(ids)
+        })
+    }
+
     fn windows(&self) -> NiriFuture<'_, Vec<WindowInfo>> {
         Box::pin(async move { parse_windows(&self.request(&json!("Windows")).await?) })
